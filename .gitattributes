# Container-/Linux-kritische Dateien IMMER mit LF speichern und auschecken.
# CRLF würde Shebangs in den Shell-Scripts und das Containerfile auf der
# Kunden-VM zerschießen (unabhängig von core.autocrlf des Auscheckenden).
*.sh                    text eol=lf
appliance/Containerfile text eol=lf
.dockerignore           text eol=lf
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.mjs                   text eol=lf

# qrcode.js ist die einzige Textdatei, deren SHA-256 in sbom.cdx.json steht.
# Ohne feste Zeilenenden liefert ein Windows-Checkout CRLF und damit einen
# anderen Hash als die SBOM angibt - die Pruefung schlaege dort faelschlich fehl.
qrcode.js               text eol=lf
